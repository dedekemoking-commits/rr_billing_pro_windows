<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Overlay Widget: sudut kanan atas, transparan, touch pass-through -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_card"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_rental"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RR Billing Pro"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_meja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEJA 1"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="01:00:00"
            android:textColor="@color/neon_green"
            android:textSize="22sp"
            android:textStyle="bold"
            android:typeface="monospace" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_lunas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 0 LUNAS"
        android:textColor="@color/neon_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_tagihan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 0 TAGIHAN"
        android:textColor="@color/neon_red"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 0 TOTAL"
        android:textColor="@color/neon_yellow"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

</LinearLayout>
