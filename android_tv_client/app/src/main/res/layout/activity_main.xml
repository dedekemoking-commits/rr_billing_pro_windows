<?xml version="1.0" encoding="utf-8"?>
<!-- Layar setup: IP server kasir + meja_id -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RR Billing TV"
            android:textColor="@color/neon_cyan"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Floating Overlay Timer &amp; Lockscreen"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="IP Server Kasir"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_server_ip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="contoh: 192.168.1.100"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Port WebSocket"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_server_port"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="8080"
            android:inputType="number"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ID Meja (sama dengan nama TV di kasir)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_meja_id"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="contoh: TV 1"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input" />

        <Button
            android:id="@+id/btn_save_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="SIMPAN &amp; MULAI OVERLAY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_purple" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="HENTIKAN SERVICE"
            android:textSize="16sp"
            android:backgroundTint="#FF4444" />

        <Button
            android:id="@+id/btn_overlay_perm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="IZIN OVERLAY"
            android:textSize="16sp"
            android:backgroundTint="#333333" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Service: mati"
            android:textColor="@color/neon_yellow"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_overlay_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
