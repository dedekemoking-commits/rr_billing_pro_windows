<?xml version="1.0" encoding="utf-8"?>
<!--
  Lockscreen fullscreen saat waktu habis / standby.

  Tata letak (mengikuti gaya layar QR sesi member):
    KIRI  ±25% : logo, "WAKTU SEWA HABIS", nama meja, timer, rincian tagihan
    KANAN ±75% : video gambar bergerak (gambar/air/video) dari media server kasir

  Catatan: video TIDAK memakai PlayerView/SurfaceView. Di beberapa STB saat
  lockscreen berjalan dalam lock-task mode, SurfaceView tidak dirender sama
  sekali (layar tetap hitam walau player jalan). Karena itu TextureView
  disisipkan dari kode (LockScreenActivity.applyLockBg) ke dalam
  @id/fl_lock_video — TextureView aman di semua STB.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:id="@+id/ll_lock_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ═══ KIRI: waktu habis + info sewa (¼ layar) ═══ -->
        <LinearLayout
            android:id="@+id/ll_lock_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_lock"
                android:contentDescription="Logo" />

            <TextView
                android:id="@+id/tv_lock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="WAKTU SEWA HABIS"
                android:textColor="@color/neon_red"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_meja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MEJA 1"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="00:00:00"
                android:textColor="@color/neon_green"
                android:textSize="34sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Rincian tagihan (Sewa / Makanan / Minuman / Total) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_lock_bill"
                android:padding="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_bill_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hubungi kasir untuk perpanjang waktu"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- ═══ KANAN: video gambar bergerak (¾ layar) ═══ -->
        <FrameLayout
            android:id="@+id/fl_lock_video"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#FF000000">

            <TextView
                android:id="@+id/tv_lock_video_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="TV sedang tidur\nHubungi kasir untuk melanjutkan"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
